# TaxMax API (TaxMax-Backend). Local default port is 5002; dev/staging containers use 5004/5003.
VITE_API_BASE_URL=http://localhost:5002

# Digits in a login code. Production and local servers use 6; the dev/staging containers' static code is 4.
VITE_OTP_LENGTH=6

# Optional canonical public website URL for campaign links. Defaults to this app's origin.
# Set this to the publicly reachable website when the admin portal uses another host.
# VITE_PUBLIC_SITE_URL=https://your-public-website.example/
